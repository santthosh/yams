# Offline foundation scaffold; no provider credentials needed.
# Set only in the local API/worker environment; never publish PostgreSQL's port.
# The password below is illustrative. Full application Compose arrives with #25.
# DATABASE_URL=postgresql+psycopg://yams:replace_local_password@postgres:5432/yams
# YAMS_FIXTURE_ROOT=/app/data/fixtures
NEXT_TELEMETRY_DISABLED=1

# Optional JSON defaults for newly admitted jobs; malformed/over-ceiling values fail.
# Existing jobs retain their recorded limits. Resource enforcement requires Linux cgroup v2.
# YAMS_JOB_LIMITS={"wall_seconds":60,"memory_mib":1024}

# Web-server-only upstream. Browser traffic stays on the web origin.
# Use http://127.0.0.1:8000 for native development; Compose uses http://api:8000.
# API_INTERNAL_ORIGIN=http://api:8000
