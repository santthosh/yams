{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256",
        "schema_version"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ForecastAllocation": {
      "additionalProperties": false,
      "properties": {
        "cash_weight": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Cash Weight",
          "type": "string"
        },
        "upfront_cost_usd": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]{0,21})(\\.[0-9]{1,2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upfront Cost Usd"
        },
        "weights": {
          "items": {
            "$ref": "#/$defs/ForecastWeight"
          },
          "title": "Weights",
          "type": "array"
        }
      },
      "required": [
        "weights",
        "cash_weight",
        "upfront_cost_usd"
      ],
      "title": "ForecastAllocation",
      "type": "object"
    },
    "ForecastOutcome": {
      "additionalProperties": false,
      "properties": {
        "median_ending_value_usd": {
          "pattern": "^(0|[1-9][0-9]{0,21})(\\.[0-9]{1,2})?$",
          "title": "Median Ending Value Usd",
          "type": "string"
        },
        "median_return_fraction": {
          "ge": -1,
          "title": "Median Return Fraction",
          "type": "number"
        },
        "p10_return_fraction": {
          "ge": -1,
          "title": "P10 Return Fraction",
          "type": "number"
        },
        "p90_return_fraction": {
          "ge": -1,
          "title": "P90 Return Fraction",
          "type": "number"
        },
        "probability_of_loss": {
          "ge": 0,
          "le": 1,
          "title": "Probability Of Loss",
          "type": "number"
        }
      },
      "required": [
        "median_return_fraction",
        "p10_return_fraction",
        "p90_return_fraction",
        "probability_of_loss",
        "median_ending_value_usd"
      ],
      "title": "ForecastOutcome",
      "type": "object"
    },
    "ForecastWeight": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "weight": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Weight",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "weight"
      ],
      "title": "ForecastWeight",
      "type": "object"
    },
    "RNGMetadata": {
      "additionalProperties": false,
      "properties": {
        "generator": {
          "const": "PCG64",
          "title": "Generator",
          "type": "string"
        },
        "initial_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "numpy_version": {
          "title": "Numpy Version",
          "type": "string"
        },
        "sampling_version": {
          "const": "noncircular_c_order_v1",
          "title": "Sampling Version",
          "type": "string"
        }
      },
      "required": [
        "generator",
        "numpy_version",
        "sampling_version",
        "initial_state"
      ],
      "title": "RNGMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of_session": {
      "format": "date",
      "title": "As Of Session",
      "type": "string"
    },
    "block_length_sessions": {
      "maximum": 5,
      "minimum": 5,
      "title": "Block Length Sessions",
      "type": "integer"
    },
    "calendar_version": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Calendar Version"
    },
    "cash_return_fraction": {
      "ge": 0,
      "le": 0,
      "title": "Cash Return Fraction",
      "type": "number"
    },
    "comparability": {
      "const": "common_shock_paths",
      "title": "Comparability",
      "type": "string"
    },
    "current_allocation": {
      "$ref": "#/$defs/ForecastAllocation"
    },
    "data_status": {
      "enum": [
        "synthetic_fixture",
        "research_market_data"
      ],
      "title": "Data Status",
      "type": "string"
    },
    "decision_cutoff_utc": {
      "format": "date-time",
      "pattern": "Z$",
      "title": "Decision Cutoff Utc",
      "type": "string"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fingerprint"
    },
    "fingerprint_schema_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Fingerprint Schema Version",
      "type": "integer"
    },
    "future_sessions": {
      "anyOf": [
        {
          "items": {
            "format": "date",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Future Sessions"
    },
    "hold_unchanged": {
      "anyOf": [
        {
          "$ref": "#/$defs/ForecastOutcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "horizon_calendar_days": {
      "maximum": 90,
      "minimum": 90,
      "title": "Horizon Calendar Days",
      "type": "integer"
    },
    "horizon_end_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Horizon End At"
    },
    "horizon_trading_sessions": {
      "anyOf": [
        {
          "maximum": 90,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Horizon Trading Sessions"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "initial_value_usd": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]{0,21})(\\.[0-9]{1,2})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Initial Value Usd"
    },
    "input_array_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Array Sha256"
    },
    "limitations": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "lookback_sessions": {
      "maximum": 252,
      "minimum": 252,
      "title": "Lookback Sessions",
      "type": "integer"
    },
    "median_return_delta_fraction": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Median Return Delta Fraction"
    },
    "method": {
      "const": "multivariate_block_bootstrap_v1",
      "title": "Method",
      "type": "string"
    },
    "proposed": {
      "anyOf": [
        {
          "$ref": "#/$defs/ForecastOutcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposed_allocation": {
      "$ref": "#/$defs/ForecastAllocation"
    },
    "rng": {
      "$ref": "#/$defs/RNGMetadata"
    },
    "sampled_indices": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "seed": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "simulation_count": {
      "maximum": 5000,
      "minimum": 5000,
      "title": "Simulation Count",
      "type": "integer"
    },
    "snapshot_id": {
      "format": "uuid",
      "title": "Snapshot Id",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "available",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "unavailable_reason": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unavailable Reason"
    }
  },
  "required": [
    "id",
    "status",
    "unavailable_reason",
    "as_of_session",
    "decision_cutoff_utc",
    "data_status",
    "snapshot_id",
    "snapshot_sha256",
    "calendar_version",
    "horizon_calendar_days",
    "horizon_trading_sessions",
    "horizon_end_at",
    "future_sessions",
    "method",
    "seed",
    "simulation_count",
    "lookback_sessions",
    "block_length_sessions",
    "cash_return_fraction",
    "initial_value_usd",
    "current_allocation",
    "proposed_allocation",
    "rng",
    "input_array_sha256",
    "sampled_indices",
    "fingerprint",
    "fingerprint_schema_version",
    "engine_version",
    "proposed",
    "hold_unchanged",
    "median_return_delta_fraction",
    "comparability",
    "limitations"
  ],
  "title": "ForecastV1",
  "type": "object"
}
