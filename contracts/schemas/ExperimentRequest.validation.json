{
  "$defs": {
    "EvaluationSplit": {
      "additionalProperties": false,
      "properties": {
        "holdout_fraction": {
          "gt": 0,
          "lt": 1,
          "title": "Holdout Fraction",
          "type": "number"
        },
        "kind": {
          "const": "chronological",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "holdout_fraction"
      ],
      "title": "EvaluationSplit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmark_asset_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Benchmark Asset Id",
      "type": "string"
    },
    "end_session_exclusive": {
      "format": "date",
      "title": "End Session Exclusive",
      "type": "string"
    },
    "evaluation_split": {
      "$ref": "#/$defs/EvaluationSplit"
    },
    "execution_policy_id": {
      "const": "us_eod_next_open_v1",
      "title": "Execution Policy Id",
      "type": "string"
    },
    "initial_capital_usd": {
      "pattern": "^(0|[1-9][0-9]{0,21})(\\.[0-9]{1,2})?$",
      "title": "Initial Capital Usd",
      "type": "string"
    },
    "random_seed": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "title": "Random Seed",
      "type": "integer"
    },
    "snapshot_id": {
      "format": "uuid",
      "title": "Snapshot Id",
      "type": "string"
    },
    "start_session": {
      "format": "date",
      "title": "Start Session",
      "type": "string"
    },
    "strategy_version_id": {
      "format": "uuid",
      "title": "Strategy Version Id",
      "type": "string"
    }
  },
  "required": [
    "strategy_version_id",
    "snapshot_id",
    "start_session",
    "end_session_exclusive",
    "initial_capital_usd",
    "benchmark_asset_id",
    "execution_policy_id",
    "random_seed",
    "evaluation_split"
  ],
  "title": "ExperimentRequest",
  "type": "object"
}
