{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256",
        "schema_version"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "VALIDATION_ERROR",
            "NOT_FOUND",
            "METHOD_NOT_ALLOWED",
            "STATE_CONFLICT",
            "IDEMPOTENCY_CONFLICT",
            "STALE_DATA",
            "INSUFFICIENT_MARKET_DATA",
            "LIMIT_EXCEEDED",
            "PROVIDER_UNAVAILABLE",
            "FORECAST_UNAVAILABLE",
            "JOB_FAILED",
            "INTERNAL_ERROR",
            "WORKLOAD_LIMIT",
            "RESOURCE_EXHAUSTED",
            "TIME_LIMIT"
          ],
          "title": "Code",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "details",
        "retryable",
        "correlation_id"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "EvaluationSplit": {
      "additionalProperties": false,
      "properties": {
        "holdout_fraction": {
          "gt": 0,
          "lt": 1,
          "title": "Holdout Fraction",
          "type": "number"
        },
        "kind": {
          "const": "chronological",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "holdout_fraction"
      ],
      "title": "EvaluationSplit",
      "type": "object"
    },
    "ExperimentMetrics": {
      "additionalProperties": false,
      "properties": {
        "annualized_return_fraction": {
          "$ref": "#/$defs/MetricValue"
        },
        "annualized_volatility_fraction": {
          "$ref": "#/$defs/MetricValue"
        },
        "cumulative_return_fraction": {
          "$ref": "#/$defs/MetricValue"
        },
        "fees_usd": {
          "pattern": "^(0|[1-9][0-9]{0,21})(\\.[0-9]{1,2})?$",
          "title": "Fees Usd",
          "type": "string"
        },
        "max_drawdown_fraction": {
          "$ref": "#/$defs/MetricValue"
        },
        "sharpe_ratio": {
          "$ref": "#/$defs/MetricValue"
        },
        "slippage_usd": {
          "pattern": "^(0|[1-9][0-9]{0,21})(\\.[0-9]{1,2})?$",
          "title": "Slippage Usd",
          "type": "string"
        },
        "trade_count": {
          "minimum": 0,
          "title": "Trade Count",
          "type": "integer"
        },
        "turnover_fraction": {
          "$ref": "#/$defs/MetricValue"
        }
      },
      "required": [
        "cumulative_return_fraction",
        "annualized_return_fraction",
        "annualized_volatility_fraction",
        "max_drawdown_fraction",
        "turnover_fraction",
        "sharpe_ratio",
        "slippage_usd",
        "fees_usd",
        "trade_count"
      ],
      "title": "ExperimentMetrics",
      "type": "object"
    },
    "ExperimentRequest": {
      "additionalProperties": false,
      "properties": {
        "benchmark_asset_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Benchmark Asset Id",
          "type": "string"
        },
        "end_session_exclusive": {
          "format": "date",
          "title": "End Session Exclusive",
          "type": "string"
        },
        "evaluation_split": {
          "$ref": "#/$defs/EvaluationSplit"
        },
        "execution_policy_id": {
          "const": "us_eod_next_open_v1",
          "title": "Execution Policy Id",
          "type": "string"
        },
        "initial_capital_usd": {
          "pattern": "^(0|[1-9][0-9]{0,21})(\\.[0-9]{1,2})?$",
          "title": "Initial Capital Usd",
          "type": "string"
        },
        "random_seed": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Random Seed",
          "type": "integer"
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "start_session": {
          "format": "date",
          "title": "Start Session",
          "type": "string"
        },
        "strategy_version_id": {
          "format": "uuid",
          "title": "Strategy Version Id",
          "type": "string"
        }
      },
      "required": [
        "strategy_version_id",
        "snapshot_id",
        "start_session",
        "end_session_exclusive",
        "initial_capital_usd",
        "benchmark_asset_id",
        "execution_policy_id",
        "random_seed",
        "evaluation_split"
      ],
      "title": "ExperimentRequest",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "unavailable_reason": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unavailable Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "unavailable_reason"
      ],
      "title": "MetricValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "Z$",
      "title": "Created At",
      "type": "string"
    },
    "curve_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "data_status": {
      "enum": [
        "synthetic_fixture",
        "research_market_data"
      ],
      "title": "Data Status",
      "type": "string"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "inputs": {
      "$ref": "#/$defs/ExperimentRequest"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExperimentMetrics"
        },
        {
          "type": "null"
        }
      ]
    },
    "reproducibility_manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "cancel_requested",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "trade_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "id",
    "job_id",
    "status",
    "inputs",
    "config_sha256",
    "snapshot_sha256",
    "data_status",
    "created_at",
    "engine_version",
    "metrics",
    "curve_artifact",
    "trade_artifact",
    "reproducibility_manifest",
    "warnings",
    "error"
  ],
  "title": "ExperimentRunV1",
  "type": "object"
}
