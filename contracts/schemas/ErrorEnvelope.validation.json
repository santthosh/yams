            "STALE_DATA",
            "INSUFFICIENT_MARKET_DATA",
            "LIMIT_EXCEEDED",
            "PROVIDER_UNAVAILABLE",
            "FORECAST_UNAVAILABLE",
            "JOB_FAILED",
            "INTERNAL_ERROR",
            "WORKLOAD_LIMIT",
            "RESOURCE_EXHAUSTED",
