{
  "$defs": {
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "VALIDATION_ERROR",
            "NOT_FOUND",
            "METHOD_NOT_ALLOWED",
            "STATE_CONFLICT",
            "IDEMPOTENCY_CONFLICT",
            "STALE_DATA",
            "INSUFFICIENT_MARKET_DATA",
            "LIMIT_EXCEEDED",
            "PROVIDER_UNAVAILABLE",
            "FORECAST_UNAVAILABLE",
            "JOB_FAILED",
            "INTERNAL_ERROR",
            "WORKLOAD_LIMIT",
            "RESOURCE_EXHAUSTED",
            "TIME_LIMIT"
          ],
          "title": "Code",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "details",
        "retryable",
        "correlation_id"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "JobResult": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "diagnostic",
            "resource"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "resource_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resource Id"
        }
      },
      "required": [
        "kind",
        "resource_id",
        "message"
      ],
      "title": "JobResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "Z$",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "max_attempts": {
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "progress": {
      "ge": 0,
      "le": 100,
      "title": "Progress",
      "type": "number"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "cancel_requested",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "pattern": "Z$",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "status",
    "attempts",
    "max_attempts",
    "progress",
    "created_at",
    "updated_at",
    "result",
    "error"
  ],
  "title": "JobV1",
  "type": "object"
}
